# Study Buddy Environment Configuration

# Optional: Google Gemini API key for "Best Quality" cloud mode.
# If omitted or offline, Study Buddy operates 100% locally via Ollama.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Ollama settings for offline mode
STUDY_MODEL=qwen2.5-coder:1.5b
OLLAMA_HOST=http://localhost:11434

# Optional: Custom workspace directory (defaults to current folder)
# STUDY_WORKSPACE=/path/to/study_workspace
